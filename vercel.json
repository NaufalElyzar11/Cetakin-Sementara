{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "{assets/**,data/**,panduan/**,*.css,*.js,*.html,*.png,*.ico,*.svg,*.json}"
    },
    "api/index.js": {
      "includeFiles": "{assets/**,data/**,panduan/**,*.css,*.js,*.html,*.png,*.ico,*.svg,*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ]
}
