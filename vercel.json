{
  "version": 2,
  "rewrites": [
    {
      "source": "/(server\\.js|db\\.js|package\\.json|package-lock\\.json|src/.*|data/cetakin-db\\.json|tests/.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ]
}
