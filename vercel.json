{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "{assets/**,data/**,panduan/**,*.css,*.js,*.html,*.png,*.ico,*.svg,*.json}"
    },
    "api/index.js": {
      "includeFiles": "{assets/**,data/**,panduan/**,*.css,*.js,*.html,*.png,*.ico,*.svg,*.json}"
    }
  },
  "redirects": [
    {
      "source": "/projek",
      "destination": "/projek.html",
      "statusCode": 302
    },
    {
      "source": "/projek/",
      "destination": "/projek.html",
      "statusCode": 302
    },
    {
      "source": "/gantungan-kunci",
      "destination": "/projek.html",
      "statusCode": 302
    },
    {
      "source": "/gantungan-kunci/",
      "destination": "/projek.html",
      "statusCode": 302
    },
    {
      "source": "/gantungan-kunci.html",
      "destination": "/projek.html",
      "statusCode": 302
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ]
}
