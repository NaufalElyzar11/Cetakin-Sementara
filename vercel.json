{
  "version": 2,
  "framework": null,
  "buildCommand": "node tools/build-public.cjs",
  "outputDirectory": "dist-public",
  "functions": {
    "api/index.js": {
      "includeFiles": "data/catalog-seed.json",
      "excludeFiles": "{data/cetakin-db.json,outputs/**}"
    }
  },
  "redirects": [
    {
      "source": "/projek",
      "destination": "/projek.html",
      "statusCode": 302
    },
    {
      "source": "/projek/",
      "destination": "/projek.html",
      "statusCode": 302
    },
    {
      "source": "/gantungan-kunci",
      "destination": "/projek.html",
      "statusCode": 302
    },
    {
      "source": "/gantungan-kunci/",
      "destination": "/projek.html",
      "statusCode": 302
    },
    {
      "source": "/gantungan-kunci.html",
      "destination": "/projek.html",
      "statusCode": 302
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ]
}
